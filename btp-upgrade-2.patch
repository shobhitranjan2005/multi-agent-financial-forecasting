+@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500&display=swap');
+:root{--bg:#f6f7fb;--card:#fff;--ink:#0f172a;--mute:#64748b;--line:#e5e7ef;--brand:#6366f1;--brand2:#06b6d4;--up:#059669;--upbg:#d1fae5;--down:#dc2626;--downbg:#fee2e2;--hold:#d97706;--holdbg:#fef3c7;--r:16px;--sh:0 1px 2px rgba(15,23,42,.04),0 8px 24px rgba(15,23,42,.06)}
+@media(prefers-color-scheme:dark){:root{--bg:#070b16;--card:#0f1629;--ink:#e8ecf7;--mute:#8b97b5;--line:#1c2540;--upbg:#064e3b;--downbg:#4c1d1d;--holdbg:#4a3410;--sh:0 8px 28px rgba(0,0,0,.45)}}
+*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,system-ui,sans-serif;-webkit-font-smoothing:antialiased}
+.app{display:grid;grid-template-columns:320px 1fr;min-height:100vh}
+.side{padding:28px 22px;border-right:1px solid var(--line);background:var(--card);position:sticky;top:0;height:100vh;overflow:auto}
+.brand{display:flex;align-items:center;gap:12px;font-weight:800;font-size:1.15rem;letter-spacing:-.02em}
+.logo{width:36px;height:36px;border-radius:11px;background:linear-gradient(135deg,var(--brand),var(--brand2));display:grid;place-items:center;color:#fff}
+.tag{font-size:.7rem;color:var(--mute);margin:6px 0 26px}
+label{display:block;font-size:.72rem;font-weight:600;color:var(--mute);text-transform:uppercase;letter-spacing:.06em;margin:18px 0 7px}
+input[type=text],input[type=date]{width:100%;padding:11px 13px;border-radius:12px;border:1px solid var(--line);background:var(--bg);color:var(--ink);font:500 .95rem 'JetBrains Mono',monospace;outline:none;transition:.15s}
+input:focus{border-color:var(--brand);box-shadow:0 0 0 3px rgba(99,102,241,.18)}
+.chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:9px}
+.chip{border:1px solid var(--line);background:none;color:var(--mute);padding:5px 10px;border-radius:99px;font-size:.72rem;cursor:pointer;transition:.15s}
+.chip:hover{color:var(--brand);border-color:var(--brand)}
+.switch{display:flex;justify-content:space-between;align-items:center;margin-top:22px;padding:13px 14px;border:1px solid var(--line);border-radius:12px;font-size:.88rem;font-weight:500;cursor:pointer}
+.switch small{display:block;color:var(--mute);font-weight:400;font-size:.72rem;margin-top:2px}
+.tog{width:42px;height:24px;border-radius:99px;background:var(--line);position:relative;transition:.2s;flex:none}
+.tog::after{content:"";position:absolute;top:3px;left:3px;width:18px;height:18px;border-radius:50%;background:#fff;transition:.2s}
+.tog.on{background:var(--brand)}.tog.on::after{left:21px}
+.run{width:100%;margin-top:22px;padding:14px;border:0;border-radius:13px;color:#fff;font:700 .95rem Inter;cursor:pointer;background:linear-gradient(135deg,var(--brand),var(--brand2));box-shadow:0 8px 20px rgba(99,102,241,.35);display:flex;gap:8px;justify-content:center;align-items:center;transition:.15s}
+.run:hover{transform:translateY(-1px)}.run:disabled{opacity:.55;cursor:wait;transform:none}
+.note{margin-top:22px;padding:12px 14px;border-radius:12px;background:var(--bg);font-size:.72rem;color:var(--mute);line-height:1.5}
+main{padding:30px 34px;display:flex;flex-direction:column;gap:20px;max-width:1180px;width:100%}
+.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:22px;box-shadow:var(--sh)}
+.card h3{margin:0 0 14px;font-size:.78rem;text-transform:uppercase;letter-spacing:.07em;color:var(--mute);font-weight:700}
+.head{display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:10px}
+.head h2{margin:0;font-size:1.9rem;letter-spacing:-.03em}.head span{color:var(--mute);font-size:.88rem}
+.badge{display:inline-flex;gap:6px;align-items:center;padding:6px 12px;border-radius:99px;background:var(--upbg);color:var(--up);font-size:.74rem;font-weight:600}
+.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px}
+.kpi{padding:16px 18px;border-radius:14px;background:var(--card);border:1px solid var(--line);box-shadow:var(--sh)}
+.kpi small{color:var(--mute);font-size:.72rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em}
+.kpi b{display:block;margin-top:6px;font-size:1.4rem;letter-spacing:-.02em}
+.steps{display:flex;gap:6px;margin:4px 0 14px}
+.step{flex:1;height:6px;border-radius:9px;background:var(--line);transition:.4s}.step.on{background:linear-gradient(90deg,var(--brand),var(--brand2))}
+.log{font:500 .76rem 'JetBrains Mono',monospace;color:var(--mute);max-height:150px;overflow:auto;line-height:1.8}
+.log .d{color:var(--up)}
+.result{display:grid;grid-template-columns:minmax(260px,340px) 1fr;gap:20px}
+@media(max-width:1000px){.app{grid-template-columns:1fr}.side{position:static;height:auto}.result{grid-template-columns:1fr}main{padding:20px}}
+.sig{border-radius:var(--r);padding:26px;text-align:center}
+.sig.buy{background:var(--upbg);color:var(--up)}.sig.sell{background:var(--downbg);color:var(--down)}.sig.hold{background:var(--holdbg);color:var(--hold)}
+.sig .w{font-size:3rem;font-weight:800;letter-spacing:-.04em;line-height:1}
+.sig .rng{margin-top:12px;font:600 .95rem 'JetBrains Mono',monospace;color:var(--ink)}
+.conf{margin-top:18px;height:8px;border-radius:9px;background:rgba(127,127,127,.2);overflow:hidden}.conf i{display:block;height:100%;background:currentColor;border-radius:9px}
+.sig small{display:block;margin-top:7px;color:var(--ink);opacity:.7;font-size:.76rem}
+.reason{line-height:1.7;font-size:.93rem;color:var(--ink)}
+.risks{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
+.risk{padding:6px 12px;border-radius:99px;background:var(--downbg);color:var(--down);font-size:.76rem;font-weight:500}
+.debate{display:grid;grid-template-columns:1fr 1fr;gap:14px}
+@media(max-width:800px){.debate{grid-template-columns:1fr}}
+.turn{padding:16px;border-radius:14px;border:1px solid var(--line)}
+.turn.bull{background:linear-gradient(180deg,var(--upbg),transparent 70%)}.turn.bear{background:linear-gradient(180deg,var(--downbg),transparent 70%)}
+.turn h4{margin:0 0 8px;font-size:.82rem}.turn ul{margin:0;padding-left:18px;font-size:.84rem;line-height:1.6}
+.news a,.news div{display:block;padding:9px 0;border-bottom:1px solid var(--line);font-size:.86rem;color:var(--ink);text-decoration:none}
+.err{padding:14px 16px;border-radius:12px;background:var(--downbg);color:var(--down);font-size:.88rem}
+.empty{text-align:center;padding:60px 20px;color:var(--mute)}
+@keyframes sp{to{transform:rotate(360deg)}}.spin{animation:sp 1s linear infinite}
